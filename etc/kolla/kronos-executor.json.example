{
    "command": "kronos-executor --config-file /etc/kronos/kronos.conf --aggregate gpu-aggregate",
    "config_files": [
        {
            "source": "/var/lib/kolla/config_files/kronos.conf",
            "dest": "/etc/kronos/kronos.conf",
            "owner": "kronos",
            "perm": "0600"
        }
    ]
}
